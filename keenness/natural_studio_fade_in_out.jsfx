desc:Natural Studio Fade-in/out
desc:Natural Studio Fade-in/out [Keenness]
//tags: Volume, Master, Utility, EQ, Stereo Width
//author: Keenness

/*
  This JSFX creates a natural, analogue-sounding "Studio Fade-out" (or Fade-in),
  inspired by Audacity's native studio fade effect.
  
  As the volume decreases, it simultaneously applies a subtle low-shelf and
  high-shelf filter to reduce mud and air, and slightly attenuates the Side
  channel to narrow the stereo width. This mimics the psychoacoustic reality of
  a sound source moving further away from the listener.
  
  PRO TIP: For the most musical and natural results, use this plugin at the end
  of your master chain and automate the Volume slider using a Cosine (Slow
  start/end) envelope curve.

  © 2026 Gustavo Moraes <keenness@pm.me> - MIT License
*/

slider1:100<0,100,0.001>Volume (%)

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init

// --- User Customizable Settings ---
// These values determine the maximum intensity of the effect at 0% Volume.
max_eq_db   = -6.0; // Maximum shelf filters attenuation (dB)
max_side_db = -2.0; // Maximum Side channel attenuation (dB)
ls_freq     = 200;  // Low-shelf cutoff frequency (Hz)
hs_freq     = 10000;// High-shelf cutoff frequency (Hz)
// ----------------------------------

ext_tail_size = -2;
amp = slider1 / 100;
last_eq_gain = 999;
side_amp = 1.0;

// --- Biquad EQ Functions (RBJ Cookbook) ---
function init_lowshelf(freq, q)
instance(cosw0, alpha)
local(w0, sinw0)
(
  w0 = 2 * $pi * freq / srate;
  cosw0 = cos(w0);
  sinw0 = sin(w0);
  alpha = sinw0 / (2 * q);
);

function update_lowshelf_gain(gain_db)
instance(cosw0, alpha, a1, a2, b0, b1, b2)
local(A, a0, sqrtA2alpha)
(
  A = 10^(gain_db/40.0);
  sqrtA2alpha = 2 * sqrt(A) * alpha;

  a0 = (A+1) + (A-1)*cosw0 + sqrtA2alpha;
  b0 = (A*( (A+1) - (A-1)*cosw0 + sqrtA2alpha )) / a0;
  b1 = (2*A*( (A-1) - (A+1)*cosw0 )) / a0;
  b2 = (A*( (A+1) - (A-1)*cosw0 - sqrtA2alpha )) / a0;
  a1 = (-2*( (A-1) + (A+1)*cosw0 )) / a0;
  a2 = ((A+1) + (A-1)*cosw0 - sqrtA2alpha) / a0;
);

function init_highshelf(freq, q)
instance(cosw0, alpha)
local(w0, sinw0)
(
  w0 = 2 * $pi * freq / srate;
  cosw0 = cos(w0);
  sinw0 = sin(w0);
  alpha = sinw0 / (2 * q);
);

function update_highshelf_gain(gain_db)
instance(cosw0, alpha, a1, a2, b0, b1, b2)
local(A, a0, sqrtA2alpha)
(
  A = 10^(gain_db/40.0);
  sqrtA2alpha = 2 * sqrt(A) * alpha;

  a0 = (A+1) - (A-1)*cosw0 + sqrtA2alpha;
  b0 = (A*( (A+1) + (A-1)*cosw0 + sqrtA2alpha )) / a0;
  b1 = (-2*A*( (A-1) + (A+1)*cosw0 )) / a0;
  b2 = (A*( (A+1) + (A-1)*cosw0 - sqrtA2alpha )) / a0;
  a1 = (2*( (A-1) - (A+1)*cosw0 )) / a0;
  a2 = ((A+1) - (A-1)*cosw0 - sqrtA2alpha) / a0;
);

function process_biquad(x, b0, b1, b2, a1, a2)
instance(x1, x2, y1, y2)
local(y)
(
  y = b0*x + b1*x1 + b2*x2 - a1*y1 - a2*y2;
  x2 = x1;
  x1 = x;
  y2 = y1;
  y1 = y;
  y;
);

// --- Initialize Static Filters ---
ls.init_lowshelf(ls_freq, 0.35);
hs.init_highshelf(hs_freq, 0.5);

@slider
damp = 0.0;

@block
cnt = 0;
damp = 0.0;

amp_chg_splpos = slider_next_chg(1, tgt_slider_val);

amp_chg_splpos > 0 ? (
  amp = slider1 / 100;
  tgt_amp = tgt_slider_val / 100;
) : (
  tgt_amp = slider1 / 100;
  amp_chg_splpos = samplesblock;
);

// Calculate per-sample amplitude delta for smooth automation
damp = (tgt_amp - amp) / amp_chg_splpos;

@sample
cnt == amp_chg_splpos ? (
  damp = 0.0;
  amp_chg_splpos = slider_next_chg(1, tgt_slider_val);
  amp_chg_splpos > cnt ? (
    tgt_amp = tgt_slider_val / 100;
    damp = (tgt_amp - amp) / (amp_chg_splpos - cnt);
  );
);

// 1. Calculate inverted fade depth (0.0 at max vol, 1.0 at zero vol)
fade_depth = 1.0 - amp;

// Linearly map target gains based on fade depth
eq_gain = fade_depth * max_eq_db;
side_gain = fade_depth * max_side_db;

// Update coefficients only if volume/gain has changed to save CPU
eq_gain != last_eq_gain ? (
  ls.update_lowshelf_gain(eq_gain);
  hs.update_highshelf_gain(eq_gain);
  side_amp = 10^(side_gain / 20.0); // Convert Side dB to linear multiplier
  last_eq_gain = eq_gain;
);

// 2. Apply Main Volume Fade
spl0 *= amp;
spl1 *= amp;

// 3. Mid/Side Processing (Proportional Stereo Narrowing)
mid = (spl0 + spl1) * 0.5;
side = (spl0 - spl1) * 0.5;

side *= side_amp; 

spl0 = mid + side; // Reconstruct Left
spl1 = mid - side; // Reconstruct Right

// 4. Apply Shelf Filters (L/R)
spl0 = ls_L.process_biquad(spl0, ls.b0, ls.b1, ls.b2, ls.a1, ls.a2);
spl1 = ls_R.process_biquad(spl1, ls.b0, ls.b1, ls.b2, ls.a1, ls.a2);

spl0 = hs_L.process_biquad(spl0, hs.b0, hs.b1, hs.b2, hs.a1, hs.a2);
spl1 = hs_R.process_biquad(spl1, hs.b0, hs.b1, hs.b2, hs.a1, hs.a2);

amp += damp;
cnt += 1;
